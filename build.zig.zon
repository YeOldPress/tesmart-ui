.{
    .name = "tesmart-ui-zig",
    .version = "0.1.0",
    .minimum_zig_version = "0.14.0",
    .dependencies = .{
        .raylib_zig = .{
            // Before building, run:
            //   zig fetch --save https://github.com/Not-Nik/raylib-zig/archive/devel.tar.gz
